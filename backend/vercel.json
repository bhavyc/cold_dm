{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/health.js"
    },
    {
      "src": "/api/waitlist",
      "dest": "api/waitlist.js"
    },
    {
      "src": "/api/generate",
      "dest": "api/generate.js"
    },
    {
      "src": "/replywave.zip",
      "dest": "public/replywave.zip"
    },
    {
      "src": "/privacy.html",
      "dest": "public/privacy.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
