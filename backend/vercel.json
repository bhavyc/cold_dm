{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/health.js"
    },
    {
      "src": "/api/waitlist",
      "dest": "api/waitlist.js"
    },
    {
      "src": "/api/generate",
      "dest": "api/generate.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/health.js"
    }
  ]
}
